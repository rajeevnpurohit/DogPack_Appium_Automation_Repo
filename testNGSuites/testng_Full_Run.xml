<!-- =========================================================================
     testng_Full_Run.xml - FLOW-WISE EXECUTION ORDER
     =========================================================================
     Tests are organized in LOGICAL USER JOURNEY ORDER instead of
     Smoke/Regression split. This makes the flow easy to follow and
     mirrors how a real user would interact with the app.
 
     EXECUTION FLOW:
 
       PHASE 1 - PRE-LOGIN / ENTRY POINTS
          1. Dogpack_WithoutLogin                  (Guest browsing)
 
       PHASE 2 - AUTHENTICATION
          2. dogpack_Login                         (Manual login)
          3. Dogpack_GmailLogin                    (Gmail SSO)
          4. Dogpack_FacebookLogin                 (FB SSO)
          5. DogPack_ForgotPassword                (Password reset)
 
       PHASE 3 - SIGNUP (All cases)
          6. DogPack_ManualSignup                  (User signup)
          7. DogPack_ManualSignupSkipCase          (Skip flow)
          8. DogPack_ManualBusinessSignup          (Business signup)
          9. DogPack_ManualBusinessSignupUnclaimed (Unclaimed business)
 
       PHASE 4 - CORE APP FEATURES
         10. Dogpack_Homepage                      (Feed + nav)
         11. Dogpack_Profile                       (User profile)
         12. DogPack_BusinessUserEditProfile       (Business profile edit)
 
       PHASE 5 - POSTING EXPERIENCE
         13. Dogpack_PostingExperience             (Photo/video post)
         14. Dogpack_PostingExperienceTextPost     (Text-only post)
 
       PHASE 6 - SETTINGS and ACTIVITY
         15. Dogpack_Settings                      (Settings + activity)
 
       PHASE 7 - PREMIUM / MONETIZATION FEATURES (11 classes)
         16. Dogpack_BoostAccount                  (Boost user)
         17. Dogpack_AiPhotoGeneration             (AI photo gen - user)
         18. Dogpack_BusinessLogin                 (Business login flow)
         19. Dogpack_BoostAccount_Business         (Boost business)
         20. Dogpack_AiPhotoGeneration_Business    (AI photo gen - business)
         21. Dogpack_Subscription_Business         (Business subscription)
         22. Dogpack_Subscription_Dog              (Dog subscription)
         23. Dogpack_Notifications                 (User notifications)
         24. Dogpack_Notifications_Business        (Business notifications)
         25. Dogpack_Marketplace                   (Marketplace user)
         26. Dogpack_Marketplace_Business          (Marketplace business)
 
       PHASE 8 - ACCOUNT LIFECYCLE (Run LAST - destructive)
         27. Dogpack_AccountDeletion               (User account deletion)
         28. Dogpack_AccountDeletion_Business      (Business account deletion)
 
     ADDITIONAL (commented out, preserved):
         - dogpack_PhotoChallange  (was disabled in original)
         - Dogpack_Map             (was disabled in original)
 
     ACTIVE CLASSES:  28
     COMMENTED CLASSES: 2 (dogpack_PhotoChallange + Dogpack_Map only)
     TOTAL CLASSES: 30 (no class missed)
 
     RUN COMMAND:
       mvn test -DsuiteXmlFile=testNGSuites/testng_Full_Run.xml
 
     RUNTIME ESTIMATE: ~50-90 min on a single device.
 
     KNOWN FAILURES (carried over from original):
       Dogpack_FacebookLogin         - SocialLoginPage.java:348 timeout
       DogPack_ManualBusinessSignup  - ManualSignupPage.java:1439 "Phone Number"
       Dogpack_Homepage              - HomePage.java:926 filter open
       Dogpack_Profile               - ProfilePage.java:321 + 635 app crash
     ========================================================================= -->
<!--            <class name="org.rahulshettyacademy.Dogpack_PostingExperience" />-->
<!--            <class name="org.rahulshettyacademy.Dogpack_PostingExperienceTextPost" />-->
<suite name="DogPack Full Run (Flow-Wise)"
       parallel="false"
       thread-count="1">
 
    <listeners>
        <listener class-name="org.rahulshettyacademy.TestUtils.Listeners" />
    </listeners>
 
    <test name="DogPack End-to-End Flow" preserve-order="true">
 
        <classes>
 
            <!-- ================================================================
                 PHASE 1 - PRE-LOGIN / ENTRY POINTS
                 ================================================================ -->
            <class name="org.rahulshettyacademy.Dogpack_WithoutLogin" />
 
<!--             ================================================================-->
<!--                 PHASE 2 - AUTHENTICATION (Login flows)-->
<!--             ================================================================ -->
            <class name="org.rahulshettyacademy.dogpack_Login" />
            <class name="org.rahulshettyacademy.Dogpack_GmailLogin" />
            <class name="org.rahulshettyacademy.Dogpack_FacebookLogin" />
            <class name="org.rahulshettyacademy.DogPack_ForgotPassword" />
 
<!--             ================================================================-->
<!--                 PHASE 3 - SIGNUP (All cases - user + business)-->
<!--             ================================================================ -->
            <class name="org.rahulshettyacademy.DogPack_ManualSignup" />
            <class name="org.rahulshettyacademy.DogPack_ManualSignupSkipCase" />
            <class name="org.rahulshettyacademy.DogPack_ManualBusinessSignup" />
            <class name="org.rahulshettyacademy.DogPack_ManualBusinessSignupUnclaimed" />
 
<!--             ================================================================-->
<!--                 PHASE 4 - CORE APP FEATURES (Homepage + Profile)-->
<!--             ================================================================ -->
            <class name="org.rahulshettyacademy.Dogpack_Homepage" />
            <class name="org.rahulshettyacademy.Dogpack_Map" />
            <class name="org.rahulshettyacademy.Dogpack_Profile" />
            <class name="org.rahulshettyacademy.DogPack_BusinessUserEditProfile" />
 
<!--             ================================================================-->
<!--                 PHASE 5 - POSTING EXPERIENCE (Photo/Video + Text)-->
<!--             ================================================================ -->
            <class name="org.rahulshettyacademy.Dogpack_AddTextPost_native" />
<!--            <class name="org.rahulshettyacademy.Dogpack_VideoFeed" />-->
            <class name="org.rahulshettyacademy.Dogpack_SearchAndDiscovery" />
            <class name="org.rahulshettyacademy.dogpack_PhotoChallange" />

<!--             ================================================================ -->
<!--                 PHASE 6 - SETTINGS and ACTIVITY-->
<!--             ================================================================ -->
            <class name="org.rahulshettyacademy.Dogpack_Settings" />
 
<!--             ================================================================-->
<!--                 PHASE 7 - PREMIUM / MONETIZATION FEATURES-->
<!--             ================================================================-->
            <class name="org.rahulshettyacademy.Dogpack_BoostAccount" />
            <class name="org.rahulshettyacademy.Dogpack_AiPhotoGeneration" />
            <class name="org.rahulshettyacademy.Dogpack_BusinessLogin" />
            <class name="org.rahulshettyacademy.Dogpack_BoostAccount_Business" />
            <class name="org.rahulshettyacademy.Dogpack_AiPhotoGeneration_Business" />
            <class name="org.rahulshettyacademy.Dogpack_Subscription_Business" />
            <class name="org.rahulshettyacademy.Dogpack_Subscription_Dog" />
            <class name="org.rahulshettyacademy.Dogpack_Notifications" />
            <class name="org.rahulshettyacademy.Dogpack_Notifications_Business" />
            <class name="org.rahulshettyacademy.Dogpack_Marketplace" />
            <class name="org.rahulshettyacademy.Dogpack_Marketplace_Business" />
 
<!--             ================================================================-->
<!--                 PHASE 8 - ACCOUNT LIFECYCLE (Runs LAST - destructive!)-->
<!--                 These delete accounts so they must run at the very end.-->
<!--             ================================================================ -->
            <class name="org.rahulshettyacademy.Dogpack_AccountDeletion" />
            <class name="org.rahulshettyacademy.Dogpack_AccountDeletion_Business" />

 
        </classes>
 
    </test>
 
</suite>
 