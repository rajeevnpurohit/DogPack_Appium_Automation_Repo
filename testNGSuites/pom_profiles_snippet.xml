<!-- =========================================================================
     pom_profiles_snippet.xml — Maven profiles to paste into your pom.xml.

     INSTRUCTIONS:
       1. Open the project pom.xml.
       2. Locate the existing <profiles> ... </profiles> block (around
          line 76 — already contains profiles named Login, Regression,
          and Smoke).
       3. Paste the TWO <profile> blocks below INSIDE that <profiles>
          block, alongside the existing ones. Do NOT add another
          <profiles> wrapper.
       4. Save. Maven will pick them up immediately — no `mvn clean`
          required.

     USAGE AFTER PASTING:
       mvn test -P SubscriptionFeatures       (full 30-test suite)
       mvn test -P SubscriptionFeaturesSmoke  (smoke-only 16-test suite)
     ========================================================================= -->

<!-- ============================================================ -->
<!-- Full suite: all 30 tests across Boost / AI / Subscription   -->
<!-- ============================================================ -->
<profile>
    <id>SubscriptionFeatures</id>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>testNGSuites/testng_Boost_AI_Subscription.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
</profile>

<!-- ============================================================ -->
<!-- Smoke variant: fastest iteration, only "Smoke"-tagged tests -->
<!-- ============================================================ -->
<profile>
    <id>SubscriptionFeaturesSmoke</id>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>testNGSuites/testng_Boost_AI_Subscription_Smoke.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
</profile>
