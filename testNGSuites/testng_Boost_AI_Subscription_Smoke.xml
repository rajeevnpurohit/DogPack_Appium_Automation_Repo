<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- =========================================================================
     testng_Boost_AI_Subscription_Smoke.xml - SMOKE-only variant of the
     isolated suite. Runs only the tests annotated with groups={"Smoke", ...}.

     EXECUTION ORDER (preserve-order="true" guarantees suite XML order):
       1. Dogpack_BoostAccount               - dog-user Boost flows (Monthly + Annual)
       2. Dogpack_AiPhotoGeneration          - dog-user AI flows (6 chained scenarios)
       3. Dogpack_BusinessLogin              - logout dog, log in as business user.
                                               NO business-side feature tests yet
                                               (transitional class, see its javadoc).
       4. Dogpack_BoostAccount_Business      - login + switch to Tipper9Business +
                                               Boost flow (Subscribe Monthly Plan
                                               for Rs.520.00).
       5. Dogpack_AiPhotoGeneration_Business - login + switch + AI flow
                                               (Subscribe chain: Monthly Rs.430 +
                                               Annual Rs.4,800; Purchase chain:
                                               10/50/200/1000 Pack).
       6. Dogpack_Subscription_Business      - login + switch + Subscription flow
                                               (Verification View Plans + AI image
                                               credits View Plans + back to Settings).
       7. Dogpack_Subscription_Dog           - login + Subscription flow on the
                                               dog entity (asserts "Boost Your
                                               Account" instead of business header).
       8. Dogpack_Notifications              - login + tap Feed + tap
                                               notifications icon + tap All + tap
                                               New + assert non-empty text on the
                                               first notification card area.
                                               Read-only - no state mutation.
       9. Dogpack_Notifications_Business     - login + switch to Tipper9Business +
                                               same notifications flow as #8.
                                               Read-only - no state mutation.
      10. Dogpack_Marketplace                - login + Settings + change location
                                               to Canada to surface the
                                               marketplace, assert "Shop" visible.
      11. Dogpack_Marketplace_Business       - login + switch to Tipper9Business +
                                               same marketplace flow as #10, then
                                               revert location to India via the
                                               @AfterMethod cleanup.
      12. Dogpack_AccountDeletion            - login as dpdelete@yopmail.com +
                                               navigate to Manage profiles +
                                               submit account deletion request
                                               (30-day server-side grace; re-login
                                               reactivates - safely repeatable).
                                               Placed LAST since it submits a
                                               destructive request.
      13. Dogpack_AccountDeletion_Business   - same as #12 but switches to the
                                               business profile first. Account
                                               deletion is account-level (not
                                               profile-level), so this exercises
                                               the same delete flow from the
                                               business-entity context. Requires
                                               a business profile to exist on
                                               dpdelete@yopmail.com.

     RUN COMMAND (direct):
       mvn test -DsuiteXmlFile=testNGSuites/testng_Boost_AI_Subscription_Smoke.xml

     RUN COMMAND (via profile - see pom.xml):
       mvn test -P SubscriptionFeaturesSmoke

     RUNTIME ESTIMATE: ~25-35 min on a single device.
     ========================================================================= -->

<suite name="DogPack Subscription Features (Smoke)"
       parallel="false"
       thread-count="1">

    <listeners>
        <listener class-name="org.rahulshettyacademy.TestUtils.Listeners" />
    </listeners>

    <test name="Boost / AI / Business-Login Smoke" preserve-order="true">

        <!-- Group filter: ONLY tests annotated with groups={"Smoke", ...} run. -->
        <groups>
            <run>
                <include name="Smoke" />
            </run>
        </groups>

        <classes>
<!--            <class name="org.rahulshettyacademy.Dogpack_BoostAccount" />-->
<!--            <class name="org.rahulshettyacademy.Dogpack_AiPhotoGeneration" />-->
<!--            <class name="org.rahulshettyacademy.Dogpack_BusinessLogin" />-->
<!--            <class name="org.rahulshettyacademy.Dogpack_BoostAccount_Business" />-->
<!--            <class name="org.rahulshettyacademy.Dogpack_AiPhotoGeneration_Business" />-->
<!--            <class name="org.rahulshettyacademy.Dogpack_Subscription_Business" />-->
<!--            <class name="org.rahulshettyacademy.Dogpack_Subscription_Dog" />-->
<!--            <class name="org.rahulshettyacademy.Dogpack_Notifications" />-->
            <class name="org.rahulshettyacademy.Dogpack_Notifications_Business" />
<!--            <class name="org.rahulshettyacademy.Dogpack_Marketplace" />-->
<!--            <class name="org.rahulshettyacademy.Dogpack_Marketplace_Business" />-->
<!--            <class name="org.rahulshettyacademy.Dogpack_AccountDeletion" />-->
<!--            <class name="org.rahulshettyacademy.Dogpack_AccountDeletion_Business" />-->
        </classes>

    </test>

</suite>