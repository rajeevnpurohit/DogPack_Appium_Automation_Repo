<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.rahulshettyacademy</groupId>
	<artifactId>AppiumFrameworkDesign</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<name>AppiumFrameworkDesign</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.source>11</maven.compiler.source>
		<maven.compiler.target>11</maven.compiler.target>
	</properties>

	<dependencies>
		<!-- Appium Java Client - works with Appium Server 3.x -->
		<dependency>
			<groupId>io.appium</groupId>
			<artifactId>java-client</artifactId>
			<version>9.3.0</version>
		</dependency>

		<!-- Selenium -->
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-java</artifactId>
			<version>4.17.0</version>
		</dependency>

		<!-- TestNG -->
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<version>7.5</version>
		</dependency>

		<!-- ExtentReports -->
		<dependency>
			<groupId>com.aventstack</groupId>
			<artifactId>extentreports</artifactId>
			<version>4.1.3</version>
		</dependency>

		<!-- Jackson for JSON -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.13.3</version>
		</dependency>

		<!-- Apache Commons IO -->
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>2.11.0</version>
		</dependency>

		<!-- BrowserStack (optional - keep if using cloud testing) -->
		<dependency>
			<groupId>com.browserstack</groupId>
			<artifactId>browserstack-java-sdk</artifactId>
			<version>1.7.0</version>
		</dependency>
	</dependencies>

	<!-- ====================================================================
	     PROFILES - FIXED: <pluginManagement> hata diya, directly <plugins>
	     Pehle pluginManagement ki vajah se testng.xml ignore ho jata tha
	     aur Surefire default *Test scan karta tha = Tests run: 0
	     ==================================================================== -->
	<profiles>
		<!-- Run only Login tests -->
		<profile>
			<id>Login</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<version>3.3.0</version>
						<configuration>
							<suiteXmlFiles>
								<suiteXmlFile>testNGSuites/testng_Login.xml</suiteXmlFile>
							</suiteXmlFiles>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<profile>
			<id>Regression</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<version>3.3.0</version>
						<configuration>
							<suiteXmlFiles>
								<suiteXmlFile>testNGSuites/testng.xml</suiteXmlFile>
							</suiteXmlFiles>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<profile>
			<id>Smoke</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<version>3.3.0</version>
						<configuration>
							<suiteXmlFiles>
								<suiteXmlFile>testNGSuites/testng_Smoke.xml</suiteXmlFile>
							</suiteXmlFiles>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- ============================================================ -->
		<!-- NEW: Boost / AI Photo Gen / Subscription - FULL SUITE        -->
		<!-- Run:  mvn test -P SubscriptionFeatures                       -->
		<!-- 30 tests across 3 classes (~18-22 min)                       -->
		<!-- ============================================================ -->
		<profile>
			<id>SubscriptionFeatures</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<version>3.3.0</version>
						<configuration>
							<suiteXmlFiles>
								<suiteXmlFile>testNGSuites/testng_Boost_AI_Subscription.xml</suiteXmlFile>
							</suiteXmlFiles>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- ============================================================ -->
		<!-- NEW: Boost / AI Photo Gen / Subscription - SMOKE only        -->
		<!-- Run:  mvn test -P SubscriptionFeaturesSmoke                  -->
		<!-- 16 tests across 3 classes (~9-12 min)                        -->
		<!-- ============================================================ -->
		<profile>
			<id>SubscriptionFeaturesSmoke</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<version>3.3.0</version>
						<configuration>
							<suiteXmlFiles>
								<suiteXmlFile>testNGSuites/testng_Boost_AI_Subscription_Smoke.xml</suiteXmlFile>
							</suiteXmlFiles>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- ============================================================ -->
		<!-- NEW: Full Run (Smoke + Regression combined)                  -->
		<!-- Run:  mvn test -P FullRun                                    -->
		<!-- 26 active classes (11 smoke + 15 regression), ~50-90 min     -->
		<!-- ============================================================ -->
		<profile>
			<id>FullRun</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<version>3.3.0</version>
						<configuration>
							<suiteXmlFiles>
								<suiteXmlFile>testNGSuites/testng_Full_Run.xml</suiteXmlFile>
							</suiteXmlFiles>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<artifactId>maven-clean-plugin</artifactId>
					<version>3.4.0</version>
				</plugin>
				<plugin>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.3.1</version>
				</plugin>
				<plugin>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.13.0</version>
				</plugin>
			</plugins>
		</pluginManagement>

		<!-- Surefire moved out of pluginManagement to make it ACTIVE by default.
		     Reason: pluginManagement only sets defaults for plugins that are already
		     active. Without active Surefire here, "mvn test -DsuiteXmlFile=..."
		     would fall back to Maven's bundled Surefire (older version) which
		     alphabetizes classes - causing Dogpack_AccountDeletion (dpdelete) to
		     run before Dogpack_BoostAccount (tip). Active Surefire 3.3.0 respects
		     XML class-declaration order. -->
		<plugins>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.3.0</version>
			</plugin>
		</plugins>
	</build>
</project>